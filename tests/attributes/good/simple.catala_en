└─ Some simple attribute tests
   └─ First tests
type Eoption = | ENone of unit | ESome of any

type S_in = { bla_in: option (integer, source_position); }
type S = { bla: integer; o: money; o2: (money, #[.] integer); }
type Str = { fld: #[.] integer; }

let scope s
  (s_in: S_in {bla_in: option (integer, source_position)})
  : S {bla: integer; o: money; o2: (money, #[.] integer)}
  =
  let get bla : option (integer, source_position) = s_in.bla_in in
  let set bla__1 : integer =
    match
      (match bla with
       | ENone →
         ESome
           (match (ENone ()) with
            | ENone → error NoValue
            | ESome arg → arg.0, <simple:8.18-21>)
       | ESome x → ESome x)
    with
    | ENone → error NoValue
    | ESome arg → arg.0
  in
  let set o : money =
    match (ENone ()) with
    | ENone → error NoValue
    | ESome arg → arg.0
  in
  let set o2 : (money, #[.] integer) =
    match (ENone ()) with
    | ENone → error NoValue
    | ESome arg → arg.0
  in
  return { S bla = bla__1; o = o; o2 = o2; }

```
