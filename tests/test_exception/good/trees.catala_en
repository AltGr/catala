```catala-test-inline
$ catala scopelang
struct Foo = {
  x: integer
}

struct Test = {
  x: integer
}

let scope Foo (y: integer|input) (x: integer|context|output) =
  let x : integer = reentrant or by default
    ⟨ ⟨ ⟨true ⊢ ⟨ ⟨y = 3 ⊢ 103⟩, ⟨y = 4 ⊢ 104⟩ | false ⊢ ∅ ⟩⟩
      | y = 2 ⊢ 102 ⟩, ⟨ ⟨y = 2 ⊢ 2⟩ | y = 1 ⊢ 1 ⟩, ⟨y = 0 ⊢ 0⟩
    | true ⊢ 1000 ⟩

let scope Test (x: integer|internal|output) =
  let foo.y : integer = ⟨true ⊢ 1⟩;
  let foo.x : integer = ∅;
  call Foo[foo];
  let x : integer = ⟨true ⊢ foo.x⟩
```

```catala-test-inline
$ catala lcalc -O --only_ite
type eoption =  | ENone of unit  | ESome of any

type Foo = { x: integer; }

type Test = { x: integer; }

type Foo_in = { y_in: integer; x_in: unit → integer; }

type Test_in = { }
 
let scope Foo
  (Foo_in: Foo_in {y_in: integer; x_in: unit → integer})
  : Foo {x: integer}
  =
  let get y : integer = Foo_in.y_in in
  let get x : unit → integer = Foo_in.x_in in
  let set x : integer =
    let opt_arg : any = x () in
    if match opt_arg with
       | ENone _ → false
       | ESome some → true then
      match opt_arg with
      | ENone _ → raise NoValueProvided
      | ESome some → some
    else
      let exc_condition : bool = y = 1 in
      let exc_condition1 : bool = y = 2 in
      let exc_condition2 : bool = y = 2 in
      let exc_condition3 : bool = false in
      let exc_condition4 : bool = y = 4 in
      let exc_condition5 : bool = y = 3 in
      let exc_branch : bool =
        exc_condition4 || exc_condition3 || exc_condition2 || exc_condition5
      in
      if y = 0 then
        if exc_condition || exc_condition1 || exc_branch then
          raise ConflictError
        else 0
      else if exc_condition1 then
        if exc_branch then raise ConflictError else 2
      else if exc_condition then
        if exc_branch then raise ConflictError else 1
      else if exc_condition4 then
        if exc_condition5 then raise ConflictError else 104
      else if exc_condition5 then 103
      else if exc_condition3 then raise NoValueProvided
      else if exc_condition2 then 102
      else 1000
  in
  return { Foo x = x; }
let scope Test (Test_in: Test_in): Test {x: integer} =
  let sub_set foo.y : integer = 1 in
  let sub_set foo.x : unit → integer = λ (_: unit) → ENone () in
  let call result : Foo {x: integer} =
    Foo { Foo_in y_in = foo.y; x_in = foo.x; }
  in
  let sub_get foo.x : integer = result.x in
  let set x : integer = foo.x in
  return { Test x = x; }

```

```catala-test-inline
$ catala lcalc -s Foo --only_ite
let scope Foo
  (Foo_in: Foo_in {y_in: integer; x_in: unit → integer})
  : Foo {x: integer}
  =
  let get y : integer = Foo_in.y_in in
  let get x : unit → integer = Foo_in.x_in in
  let set x : integer =
    let exc_condition : bool = true in
    let opt_arg : any = x () in
    let exc_condition1 : bool =
      match opt_arg with
      | ENone _ → false
      | ESome some → true
    in
    if exc_condition1 then
      match opt_arg with
      | ENone _ → raise NoValueProvided
      | ESome some → some
    else if exc_condition then
      let exc_condition2 : bool = true in
      let exc_condition3 : bool = y = 0 in
      let exc_condition4 : bool = y = 1 in
      let exc_condition5 : bool = y = 2 in
      let exc_condition6 : bool = y = 2 in
      let exc_condition7 : bool = false in
      let exc_condition8 : bool = y = 4 in
      let exc_condition9 : bool = y = 3 in
      let exc_branch : bool =
        exc_condition8 || exc_condition7 || exc_condition6 || exc_condition9
      in
      let exc_branch1 : bool = exc_condition4 || exc_condition5 in
      let exc_branch2 : bool =
        exc_condition8 || exc_condition7 || exc_condition9
      in
      if exc_condition3 then
        if exc_branch1 || exc_branch then raise ConflictError else 0
      else if exc_condition5 then
        if exc_branch then raise ConflictError else 2
      else if exc_condition4 then
        if exc_branch then raise ConflictError else 1
      else if exc_condition8 then
        if exc_condition9 then raise ConflictError else 104
      else if exc_condition9 then 103
      else if exc_condition7 then raise NoValueProvided
      else if exc_condition6 then 102
      else if exc_condition2 then 1000
      else raise NoValueProvided
    else raise NoValueProvided
  in
  return { Foo x = x; }
```

